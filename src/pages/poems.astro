---
import Base from '../layouts/Base.astro';
import data from '../data/poems.json';
---

<Base
  title="Poems &c."
  description="Poems by Melissa Ginsburg in magazines and online, and other writing."
  wash={{ color: '#F8BDB4', color2: '#FEF2E4' }}
>
  <div class="wrap">
    <h1 class="page-title">Poems &amp;c.</h1>

    <section class="block">
      <h2 class="visually-hidden">Poems</h2>
      <ul class="run">
        {
          data.poems.map((poem) => (
            <li>
              {poem.title} <span class="in">in</span> <a href={poem.url}>{poem.venue}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <h2 class="section-title">&amp;c.</h2>
      <ul class="elsewhere">
        {
          data.elsewhere.map((item) => (
            <li>
              <a href={item.url}>{item.title}</a>, <em>{item.venue}</em>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .block {
    padding-top: 72px;
    max-width: 960px;
  }
  /* One long run of poems, slash-separated, as on the old site. */
  .run {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.55;
  }
  .run li {
    display: inline;
  }
  .run li:not(:last-child)::after {
    content: ' / ';
    color: var(--muted);
    margin: 0 0.15em;
  }
  .in {
    font-style: italic;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .run li {
      display: block;
      margin-bottom: 14px;
    }
    .run li::after {
      content: none !important;
    }
  }
  .elsewhere {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
</style>

---
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import data from '../data/poems.json';
---

<Base title="Poems &c." description="Poems by Melissa Ginsburg in magazines and online, and other writing.">
  <div class="frame">
    <h1 class="visually-hidden">Poems &amp;c.</h1>

    <div class="grid top">
      <ul class="col-wide run" aria-label="Poems">
        {
          data.poems.map((poem, i) => (
            <li>
              <a href={poem.url}>{poem.title}</a>, <i class="venue">{poem.venue}</i>
              {i < data.poems.length - 1 && (
                <span class="sep" aria-hidden="true">
                  &nbsp;/&nbsp;
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="section elsewhere" aria-label="Other writing">
      {
        data.elsewhere.map((item) => (
          <Row as="li">
            <Fragment slot="note">{item.venue}</Fragment>
            <p>
              <a href={item.url}>{item.title}</a>
            </p>
          </Row>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .top {
    margin-top: var(--space-m);
  }
  /* One long run of poems, as on the old site. */
  .run {
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.55;
  }
  .run li {
    display: inline;
  }
  .venue {
    color: var(--muted);
  }
  .sep {
    color: var(--muted);
  }
  .elsewhere {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  /* On a phone, one poem to a line. */
  @media (max-width: 760px) {
    .run {
      font-size: 20px;
      line-height: 1.45;
    }
    .run li {
      display: block;
      padding: 6px 0;
    }
    .run .sep {
      display: none;
    }
  }
</style>

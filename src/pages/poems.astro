---
import Base from '../layouts/Base.astro';
import Excerpt from '../components/Excerpt.astro';
import Row from '../components/Row.astro';
import Edge from '../components/Edge.astro';
import data from '../data/poems.json';

type Poem = { title: string; venue: string; url: string; excerpt?: string };
const poems: Poem[] = data.poems;
// A few lines from a recent poem open the page: the first poem in the list
// that has an excerpt.
const featured = poems.find((poem) => poem.excerpt);
---

<Base title="Poems &c." description="Poems by Melissa Ginsburg in magazines and online, and other writing.">
  <div class="frame">
    <h1 class="visually-hidden">Poems &amp;c.</h1>

    {
      featured?.excerpt && (
        <figure class="opening">
          <Excerpt text={featured.excerpt} class="first" />
          <figcaption class="grid from">
            <span class="col-wide">
              From <a href={featured.url}>{featured.title}</a>, <i>{featured.venue}</i>
            </span>
          </figcaption>
        </figure>
      )
    }

    <section class:list={['grid', 'magazines', featured?.excerpt ? 'section' : 'first']} aria-labelledby="in-magazines">
      <Edge layout="poems" only="phone" />
      <h2 class="col-wide label run-label" id="in-magazines">Poems in magazines</h2>
      <div class="col-wide run-wrap">
        <Edge layout="poems" only="wide" />
      <ul class="run">
        {
          poems.map((poem, i) => (
            <li>
              <a href={poem.url}>{poem.title}</a>, <i class="venue">{poem.venue}</i>
              {i < poems.length - 1 && (
                <span class="sep" aria-hidden="true">
                  &#8202;/&#8202;
                </span>
              )}
            </li>
          ))
        }
      </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="elsewhere">
      <div class="grid">
        <h2 class="col-wide label run-label" id="elsewhere">Prose, video, conversation</h2>
      </div>
      <ul class="elsewhere">
        {
          data.elsewhere.map((item) => (
            <Row as="li">
              <Fragment slot="note">{item.venue}</Fragment>
              <p>
                <a href={item.url}>{item.title}</a>
              </p>
            </Row>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .from {
    margin-top: var(--space-s);
    font-size: 17px;
  }
  .run-label {
    margin-bottom: var(--space-s);
  }
  /* One long run of poems, as on the old site. */
  .run-wrap {
    position: relative;
  }
  .run-wrap,
  .run {
    font-size: clamp(20px, 1.9vw, 25px);
    line-height: 1.6;
  }
  .run a {
    text-decoration-thickness: 1px;
  }
  .run a:hover {
    text-decoration-thickness: 2px;
  }
  .run li {
    display: inline;
  }
  /* Colour pieces lie behind the run; see Edge.astro. On a phone they sit
     above it. */
  .magazines {
    position: relative;
  }
  @media (max-width: 760px) {
    .magazines {
      margin-top: calc(var(--space-m) + 96px);
    }
  }
  /* Where it appeared, not a link: italic, in ink, since the run may cross
     the orange, where grey wouldn't read. */
  /* Caslon's slash is nearly upright; hair spaces and a little room on each
     side keep it from reading as a rule. */
  .sep {
    margin-inline: 0.3em;
  }
  .elsewhere {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  /* On a phone, one poem to a line. */
  @media (max-width: 760px) {
    .run {
      font-size: 20px;
      line-height: 1.45;
    }
    .run li {
      display: block;
      padding: 6px 0;
    }
    .run .sep {
      display: none;
    }
  }
</style>

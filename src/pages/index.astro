---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Collage from '../components/Collage.astro';
import Wall from '../components/Wall.astro';
import Row from '../components/Row.astro';
import poems from '../data/poems.json';
import site from '../data/site.json';
import { countWord, formatDate, getBooks, getFeaturedBook, isFullLength, isoDate } from '../lib/books';
import { url } from '../lib/url';

const featured = await getFeaturedBook();
const books = await getBooks();
const wall = books.filter((b) => isFullLength(b) && b.id !== featured.id);
const chapbooks = books.filter((b) => !isFullLength(b)).length;

const latest = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)[0];
const LatestContent = latest ? (await render(latest)).Content : undefined;

const recent = poems.poems.slice(0, 3);
const about = await getEntry('pages', 'about');
---

<Base home image={featured.data.cover}>
  <div class="frame">
    <Collage book={featured} variant="home" />

    {
      wall.length > 0 && (
        <section class="section" aria-label="Books">
          <Wall books={wall} label="More books" />
          <p class="all-books">
            <a href={url('/books')}>
              All books{chapbooks > 0 && `, including ${countWord(chapbooks)} chapbook${chapbooks === 1 ? '' : 's'}`}
            </a>
          </p>
        </section>
      )
    }

    <div class="section rows">
      {
        latest && LatestContent && (
          <Row noteStyle="label">
            <Fragment slot="note">
              News · <time datetime={isoDate(latest.data.date)}>{formatDate(latest.data.date)}</time>
            </Fragment>
            <div class="prose">
              <LatestContent />
            </div>
            {latest.data.link && (
              <p class="more">
                <a href={latest.data.link}>{latest.data.linkLabel ?? 'More'}</a>
              </p>
            )}
          </Row>
        )
      }

      <Row noteStyle="label">
        <Fragment slot="note">Recent poems</Fragment>
        <ul class="run">
          {
            recent.map((poem) => (
              <li>
                <a href={poem.url}>{poem.title}</a>, <i>{poem.venue}</i>
                <span class="sep" aria-hidden="true">
                  &nbsp;/&nbsp;
                </span>
              </li>
            ))
          }
          <li><a href={url('/poems')}>all {poems.poems.length}</a></li>
        </ul>
      </Row>

      {
        about?.data.summary && (
          <Row>
            <p>{about.data.summary}</p>
            <p class="more">
              <a href={url('/about')}>More</a>
              <span class="sep" aria-hidden="true">
                &nbsp;·&nbsp;
              </span>
              <a href={`mailto:${site.agent.email}`}>Agent</a>
              {site.links.map((link) => (
                <>
                  <span class="sep" aria-hidden="true">
                    &nbsp;·&nbsp;
                  </span>
                  <a href={link.url}>{link.label}</a>
                </>
              ))}
            </p>
          </Row>
        )
      }
    </div>
  </div>
</Base>

<style>
  .all-books {
    margin-top: var(--space-m);
    text-align: right;
    font-size: 17px;
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
  .run li {
    display: inline;
  }
  .more {
    margin-top: 4px;
    font-size: 16px;
  }
</style>

---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Collage from '../components/Collage.astro';
import Wall from '../components/Wall.astro';
import Row from '../components/Row.astro';
import poems from '../data/poems.json';
import site from '../data/site.json';
import { formatDate, getBooks, getFeaturedBook, isFullLength, isoDate } from '../lib/books';
import { inline } from '../lib/inline';
import { url } from '../lib/url';

const featured = await getFeaturedBook();
const books = await getBooks();
const wall = books.filter((b) => isFullLength(b) && b.id !== featured.id);

// Context for the featured book, between the hero and the wall.
const { title, homeBlurb, homePraise, praise } = featured.data;
const firstSentence = (featured.body ?? '').trim().match(/^[\s\S]+?[.!?](?=\s|$)/)?.[0];
const blurb = homeBlurb ?? firstSentence;
const quote = homePraise
  ? praise.find((p) => p.name === homePraise)
  : (praise.find((p) => !p.featured) ?? praise[0]);
const featuredHref = url(`/books/${featured.id}`);

const latest = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)[0];
const LatestContent = latest ? (await render(latest)).Content : undefined;

const recent = poems.poems.slice(0, 3);
const about = await getEntry('pages', 'about');
// The About row: the bio's first and last sentences, word for word.
const bioSentences = (about?.body ?? '').replace(/\s+/g, ' ').trim().split(/(?<=[.!?])\s+(?=[A-Z])/);
const bioShort =
  bioSentences.length > 1 ? `${bioSentences[0]} ${bioSentences[bioSentences.length - 1]}` : bioSentences[0];
---

<Base home image={featured.data.cover}>
  <div class="frame">
    <Collage book={featured} variant="home" />

    {
      (blurb || quote) && (
        <section class="major context" aria-label={`About ${title}`}>
          {blurb && <p class="blurb" set:html={inline(blurb)} />}
          {quote && (
            <figure class="praise">
              <blockquote>
                <p set:html={`“${inline(quote.pull ?? quote.quote)}”`} />
              </blockquote>
              <figcaption class="label">{quote.name}</figcaption>
            </figure>
          )}
          <p class="more-about">
            <a href={featuredHref}>
              More about <i>{title}</i>
            </a>
          </p>
        </section>
      )
    }

    {
      wall.length > 0 && (
        <section class="major" aria-labelledby="also-by">
          <h2 class="heading" id="also-by">
            Also by Melissa
          </h2>
          <div class="wall-wrap">
            <Wall books={wall} label="Also by Melissa" />
          </div>
          <p class="all-books">
            <a href={url('/books')}>All books</a>
          </p>
        </section>
      )
    }

    <div class="major rows">
      {
        latest && LatestContent && (
          <Row noteStyle="label">
            <Fragment slot="note">
              News · <time datetime={isoDate(latest.data.date)}>{formatDate(latest.data.date)}</time>
            </Fragment>
            <div class="prose">
              <LatestContent />
            </div>
            {/* The hero already has the order link. */}
            {latest.data.link && latest.data.link !== featured.data.buy[0]?.url && (
              <p class="more">
                <a href={latest.data.link}>{latest.data.linkLabel ?? 'More'}</a>
              </p>
            )}
          </Row>
        )
      }

      <Row noteStyle="label">
        <Fragment slot="note">Poems</Fragment>
        <ul class="run">
          {
            recent.map((poem) => (
              <li>
                <a href={poem.url}>{poem.title}</a>, <i>{poem.venue}</i>
                <span class="sep" aria-hidden="true">
                  &nbsp;/&nbsp;
                </span>
              </li>
            ))
          }
          <li><a href={url('/poems')}>All poems</a></li>
        </ul>
      </Row>

      {
        bioShort && (
          <Row noteStyle="label">
            <Fragment slot="note">About</Fragment>
            <p set:html={inline(bioShort)} />
            <p class="more links">
              <a href={url('/about')}>About</a>
              <span class="sep" aria-hidden="true">
                &nbsp;·&nbsp;
              </span>
              <a href={url('/about#contact')}>Contact</a>
              {site.links.map((link) => (
                <>
                  <span class="sep" aria-hidden="true">
                    &nbsp;·&nbsp;
                  </span>
                  <a href={link.url}>{link.label}</a>
                </>
              ))}
            </p>
          </Row>
        )
      }
    </div>
  </div>
</Base>

<style>
  /* The featured book in a few lines, in the hero text's column: a
     description, one blurb, a link. */
  .context {
    max-width: 36%;
  }
  .blurb {
    font-size: 23px;
    line-height: 1.55;
  }
  .praise {
    margin-top: var(--space-s);
    font-size: 19px;
    line-height: 1.6;
  }
  .praise figcaption {
    margin-top: 10px;
  }
  .more-about {
    margin-top: var(--space-s);
    font-size: 17px;
  }
  .wall-wrap {
    margin-top: var(--space-m);
  }
  .all-books {
    margin-top: var(--space-m);
    font-size: 19px;
  }
  @media (max-width: 760px) {
    .context {
      max-width: none;
    }
    .blurb {
      font-size: 20px;
    }
    .praise {
      font-size: 17.5px;
    }
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
  .run li {
    display: inline;
  }
  .run .sep {
    padding-inline: 0.25em;
  }
  .more {
    margin-top: 4px;
    font-size: 16px;
  }
</style>

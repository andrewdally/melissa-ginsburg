---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Collage from '../../components/Collage.astro';
import Excerpt from '../../components/Excerpt.astro';
import PullQuote from '../../components/PullQuote.astro';
import Row from '../../components/Row.astro';
import NewsRow from '../../components/NewsRow.astro';
import Scrap from '../../components/Scrap.astro';
import { editionNotes, getBooks, type Book } from '../../lib/books';
import { inline } from '../../lib/inline';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const books = await getBooks();
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}

const { book } = Astro.props as { book: Book };
const { title, kind, tagline, cover, excerpt, excerptStagger, honors, praise, press } = book.data;
const { Content } = await render(book);
const hasDescription = !!book.body?.trim();
const notes = [...editionNotes(book), ...honors];

// The pull quote is set large; if it's only a line from a longer blurb, the
// whole blurb still appears below. Never two quotes from one person otherwise.
const pull = praise.find((p) => p.featured);
const rows = praise.filter((p) => p !== pull || (p.pull && p.pull !== p.quote));

const news = (await getCollection('news'))
  .filter((item) => item.data.book?.id === book.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const others = (await getBooks()).filter((b) => b.id !== book.id);
---

<Base title={title} description={tagline ?? `${title}, ${kind} by Melissa Ginsburg.`} image={cover}>
  <div class="frame">
    <Collage book={book} />

    {excerpt && <Excerpt text={excerpt} stagger={excerptStagger} />}

    {
      (hasDescription || notes.length > 0) && (
        <Row class="section">
          {notes.length > 0 && (
            <Fragment slot="note">
              {notes.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line.startsWith('ISBN') ? <span class="isbn">{line}</span> : line}
                </>
              ))}
            </Fragment>
          )}
          {hasDescription && (
            <div class="prose">
              <Content />
            </div>
          )}
        </Row>
      )
    }

    {
      praise.length > 0 && (
        <section class="section stack" aria-label="Praise">
          {pull && <PullQuote quote={pull.pull ?? pull.quote} name={pull.name} url={pull.url} />}
          {rows.length > 0 && (
            <ul class="stack">
              {rows.map((p) => (
                <Row as="li">
                  <Fragment slot="note">
                    {p.url ? <a href={p.url}>{p.name}</a> : p.name}
                    {p.credit && (
                      <>
                        <br />
                        <span set:html={inline(p.credit)} />
                      </>
                    )}
                  </Fragment>
                  <p class="praise" set:html={`“${inline(p.quote)}”`} />
                </Row>
              ))}
            </ul>
          )}
        </section>
      )
    }

    {
      press.length > 0 && (
        <ul class="section stack-s" aria-label="Interviews">
          {press.map((item) => (
            <Row as="li">
              <Fragment slot="note">{item.source}</Fragment>
              <p>
                <a href={item.url} set:html={inline(item.title)} />
              </p>
              {item.quote && <p class="press-quote" set:html={`“${inline(item.quote)}”`} />}
            </Row>
          ))}
        </ul>
      )
    }

    {
      news.length > 0 && (
        <ul class="section stack" aria-label="News">
          {news.map((item) => (
            <NewsRow item={item} />
          ))}
        </ul>
      )
    }

    <nav class="grid section" aria-label="Other books">
      <ul class="col-wide others">
        {
          others.map((other, i) => (
            <li>
              <a href={url(`/books/${other.id}`)}>
                <span class="scrap-size">
                  <Scrap book={other} index={i} />
                </span>
                <span class="other-title">{other.data.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Base>

<style>
  /* An ISBN never breaks at its hyphens. */
  .isbn {
    white-space: nowrap;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
  .stack-s {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .praise {
    font-size: 18px;
    line-height: 1.62;
    hanging-punctuation: first;
  }
  .press-quote {
    margin-top: 4px;
    font-size: 18px;
    line-height: 1.62;
  }
  .others {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-m);
  }
  .others a {
    display: block;
    text-decoration: none;
  }
  .others a:hover .other-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .scrap-size {
    display: block;
    font-size: 64px;
  }
  .other-title {
    display: block;
    margin-top: 12px;
    font-size: 17px;
    font-style: italic;
    line-height: 1.3;
  }
  @media (max-width: 760px) {
    .praise {
      font-size: 16.5px;
      line-height: 1.6;
    }
    .press-quote {
      font-size: 16.5px;
    }
    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-s);
    }
    .others a {
      padding: 0 0 8px;
    }
    .scrap-size {
      font-size: 56px;
    }
    .other-title {
      font-size: 16px;
    }
  }
</style>

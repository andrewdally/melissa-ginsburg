---
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import { getBooks } from '../../lib/books';

const books = await getBooks();
const groups = [
  { title: 'Poetry', books: books.filter((b) => b.data.category === 'poetry') },
  { title: 'Fiction', books: books.filter((b) => b.data.category === 'fiction') },
  { title: 'Chapbooks', books: books.filter((b) => b.data.category === 'chapbook') },
].filter((g) => g.books.length > 0);
---

<Base
  title="Books"
  description="Poetry collections, novels, and chapbooks by Melissa Ginsburg."
  wash={{ color: '#F8BDB4', color2: '#F6E3B6' }}
>
  <div class="wrap">
    <h1 class="page-title">Books</h1>
    {
      groups.map((group) => (
        <section class="group">
          <h2 class="section-title">{group.title}</h2>
          <Shelf books={group.books} details />
        </section>
      ))
    }
  </div>
</Base>

<style>
  .group {
    padding-top: 88px;
  }
  .group .section-title {
    margin-bottom: 40px;
  }
</style>

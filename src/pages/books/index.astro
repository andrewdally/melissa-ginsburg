---
import Base from '../../layouts/Base.astro';
import Wall from '../../components/Wall.astro';
import { getBooks } from '../../lib/books';

// Every book, newest first; the kind and year on each tile carry the grouping.
const books = await getBooks();
---

<Base title="Books" description="Poetry collections, novels, and chapbooks by Melissa Ginsburg.">
  <div class="frame">
    <h1 class="visually-hidden">Books</h1>
    <div class="wall-top">
      <Wall books={books} />
    </div>
  </div>
</Base>

<style>
  .wall-top {
    margin-top: var(--space-m);
  }
</style>

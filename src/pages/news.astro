---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="News"
  description="Readings, events, and news from Melissa Ginsburg."
  wash={{ color: '#F6E3B6', color2: '#F8BDB4' }}
>
  <div class="wrap">
    <h1 class="page-title">News</h1>
  </div>
  <div class="wrap column list">
    {news.length > 0 ? <NewsList items={news} /> : <p>Nothing new just now.</p>}
  </div>
</Base>

<style>
  .list {
    padding-top: 72px;
  }
</style>

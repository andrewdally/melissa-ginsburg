---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsRow from '../components/NewsRow.astro';
import Row from '../components/Row.astro';
import Tints from '../components/Tints.astro';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="News" description="Readings, events, and news from Melissa Ginsburg.">
  <Tints slot="backdrop" layout="news" />
  <div class="frame">
    <h1 class="visually-hidden">News</h1>
    {
      news.length > 0 ? (
        <ul class="list">
          {news.map((item) => (
            <NewsRow item={item} />
          ))}
        </ul>
      ) : (
        <Row class="list">
          <p>Nothing new just now.</p>
        </Row>
      )
    }
  </div>
</Base>

<style>
  .list {
    margin-top: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsRow from '../components/NewsRow.astro';
import Row from '../components/Row.astro';
import Edge from '../components/Edge.astro';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="News" description="Readings, events, and news from Melissa Ginsburg.">
  <div class="frame">
    <h1 class="visually-hidden">News</h1>
    {
      news.length > 0 ? (
        <ul class="list">
          {news.map((item, i) => (
            <NewsRow item={item}>{i === 0 && <Edge slot="decor" layout="news" />}</NewsRow>
          ))}
        </ul>
      ) : (
        <Row class="list">
          <Edge slot="decor" layout="news" />
          <p>Nothing new just now.</p>
        </Row>
      )
    }
  </div>
</Base>

<style>
  .list {
    margin-top: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
  /* Room above for the colour pieces on a phone. */
  @media (max-width: 760px) {
    .list {
      margin-top: calc(var(--space-m) + 96px);
    }
  }
</style>

---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import mac from '../assets/mac.png';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(about);
const { photo, photoAlt } = about.data;
---

<Base title="About" wash={{ color: '#A1C5E6', color2: '#DEE3E1' }} image={photo}>
  <div class="wrap">
    <h1 class="page-title">About</h1>
    <div class="about">
      {
        photo && (
          <div class="photo">
            <Image
              src={photo}
              alt={photoAlt ?? 'Melissa Ginsburg'}
              widths={[340, 680]}
              sizes="(max-width: 640px) 80vw, 340px"
            />
          </div>
        )
      }
      <div class="bio prose">
        <Content />
      </div>
    </div>

    <section class="contact">
      <h2 class="section-title">Contact</h2>
      {
        site.email && (
          <p>
            Write to Melissa at <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        )
      }
      <p>
        For rights, readings, and other inquiries, contact her agent, {site.agent.name}, at {site.agent.agency}:{' '}
        <a href={`mailto:${site.agent.email}`}>{site.agent.email}</a>.
      </p>
      {
        site.links.length > 0 && (
          <p class="sans slashes">
            {site.links.map((link, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">/</span>}
                <a href={link.url}>{link.label}</a>
              </>
            ))}
          </p>
        )
      }
    </section>

    <p class="support">
      <Image src={mac} alt="Mississippi Arts Commission" width={180} />
    </p>
  </div>
</Base>

<style>
  .about {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px 72px;
    padding-top: 72px;
  }
  .photo {
    flex: 0 1 340px;
    min-width: 220px;
    padding: 0 8px;
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    rotate: -1.5deg;
    box-shadow: 0 12px 28px rgb(27 26 24 / 0.22);
  }
  .bio {
    flex: 1 1 420px;
    min-width: 0;
    max-width: var(--measure);
  }
  .contact {
    max-width: var(--measure);
    padding-top: 96px;
  }
  .contact p {
    margin: 0 0 16px;
  }
  .support {
    margin: 96px 0 0;
    text-align: center;
  }
  .support :global(img) {
    opacity: 0.8;
    mix-blend-mode: multiply;
  }
</style>

---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import mac from '../assets/mac.png';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(about);
const { photo, photoAlt } = about.data;
---

<Base title="About" image={photo} agentInFooter={false}>
  <div class="frame">
    <h1 class="visually-hidden">About</h1>
    <div class="grid top">
      {
        photo && (
          <div class="col-photo photo">
            <Image
              src={photo}
              alt={photoAlt ?? 'Melissa Ginsburg'}
              widths={[340, 680]}
              sizes="(max-width: 760px) 90vw, 340px"
              loading="eager"
            />
          </div>
        )
      }
      <div class="col-read">
        <div class="prose bio">
          <Content />
        </div>

        <div class="contact">
          {
            site.email && (
              <p>
                Write to Melissa Ginsburg at <a href={`mailto:${site.email}`}>{site.email}</a>.
              </p>
            )
          }
          <p>
            For rights, readings, and other inquiries, contact her agent, {site.agent.name}, at{' '}
            {site.agent.agency}:&nbsp;<a href={`mailto:${site.agent.email}`}>{site.agent.email}</a>.
          </p>
          {
            site.links.map((link) => (
              <p>
                <a href={link.url}>{link.label}</a>
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div slot="footer" class="grid support">
    <div class="col-margin">
      <Image src={mac} alt="Mississippi Arts Commission" width={180} />
    </div>
    <p class="col-read">{site.macCredit}</p>
  </div>
</Base>

<style>
  .top {
    margin-top: var(--space-m);
    align-items: start;
  }
  .photo :global(img) {
    width: 100%;
    max-width: 340px;
  }
  .contact {
    margin-top: var(--space-m);
  }
  .support {
    margin-top: var(--space-m);
    align-items: center;
    row-gap: var(--space-s);
    font-size: 15px;
    font-style: italic;
  }
  .support :global(img) {
    width: 140px;
    mix-blend-mode: multiply;
  }
  @media (max-width: 760px) {
    .photo {
      margin-bottom: var(--space-m);
    }
    .photo :global(img) {
      max-width: 280px;
    }
  }
</style>

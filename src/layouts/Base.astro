---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import site from '../data/site.json';
import melissa from '../assets/melissa.jpg';
import { url, withoutBase } from '../lib/url';
import displayFont from '@fontsource/libre-caslon-display/files/libre-caslon-display-latin-400-normal.woff2?url';
import textFont from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url';
import italicFont from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-italic.woff2?url';

interface Props {
  /** Page title; omitted on the home page. */
  title?: string;
  description?: string;
  /** Image for link previews (a book cover, say). Defaults to Melissa's photo. */
  image?: ImageMetadata;
  /** The home page: the name is set large under the nav, and the footer is one line. */
  home?: boolean;
}

const { title, description = site.description, image = melissa, home = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const ogImage = await getImage({ src: image, width: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const pagePath = withoutBase(Astro.url.pathname);
const canonical = new URL(pagePath, Astro.site).href;

const nav = [
  { label: 'Books', href: '/books' },
  { label: 'Poems &c.', href: '/poems' },
  { label: 'News', href: '/news' },
  { label: 'About', href: '/about' },
];
const path = pagePath.replace(/\/$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const contacts = [
  { label: site.agent.email, url: `mailto:${site.agent.email}` },
  ...site.links,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={italicFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#F3EEE5" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    {
      import.meta.env.DEV && (
        <script is:inline>
          if (new URLSearchParams(location.search).has('grid'))
            document.documentElement.classList.add('show-grid');
        </script>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class:list={['frame', 'site-header', { home }]}>
      {!home && <a class="display site-name" href={url('/')}>{site.name}</a>}
      <nav aria-label="Main">
        <ul class="label nav">
          {
            nav.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {
        home && (
          <>
            <h1 class="display name">{site.name}</h1>
            <p class="site-tagline">{site.tagline}</p>
          </>
        )
      }
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="frame site-footer">
      {
        home ? (
          <p class="footer-line">
            {site.name}, {site.location}
          </p>
        ) : (
          <>
            <p class="footer-line">{site.footerNote}</p>
            <p class="footer-contact">
              Agent: {site.agent.name}, {site.agent.agency}
              {contacts.map((link) => (
                <>
                  <span class="sep" aria-hidden="true">
                    &nbsp;·&nbsp;
                  </span>
                  <a href={link.url}>{link.label}</a>
                </>
              ))}
            </p>
          </>
        )
      }
      <slot name="footer" />
    </footer>

    {
      import.meta.env.DEV && (
        <div class="frame grid grid-overlay" aria-hidden="true">
          {Array.from({ length: 12 }, () => (
            <span />
          ))}
        </div>
      )
    }
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: var(--space-s);
    padding-top: 12px;
  }
  .site-header.home {
    display: block;
  }
  .site-name {
    font-size: 26px;
    line-height: 1.2;
    text-decoration: none;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    column-gap: 22px;
  }
  /* Padding, not size, gives each word a 44px tap height. */
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0;
    text-decoration: none;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .nav a[aria-current='page']:hover {
    text-decoration-thickness: 2px;
  }
  .name {
    margin: 8px 0 0 -0.04em;
    font-size: clamp(64px, 11.5vw, 172px);
    line-height: 0.88;
    letter-spacing: -0.02em;
  }
  .site-tagline {
    /* Clears the name's descenders. */
    margin-top: calc(0.2 * clamp(64px, 11.5vw, 172px));
    font-size: 22px;
    font-style: italic;
    line-height: 1.3;
  }
  .site-footer {
    margin-top: var(--space-l);
    padding-bottom: var(--space-m);
  }
  .site-footer > :first-child {
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }
  .footer-line {
    font-size: 15px;
    font-style: italic;
    line-height: 1.75;
  }
  .footer-contact {
    font-size: 15px;
    line-height: 1.75;
  }

  @media (max-width: 760px) {
    .site-header:not(.home) {
      display: block;
    }
    .site-name {
      font-size: 24px;
    }
    .site-header:not(.home) .nav {
      justify-content: flex-start;
    }
    .nav {
      column-gap: 18px;
    }
    .name {
      font-size: 72px;
      margin-top: 4px;
    }
    .site-tagline {
      margin-top: 16px;
      font-size: 19px;
    }
    .footer-line,
    .footer-contact {
      font-size: 14px;
    }
  }
</style>

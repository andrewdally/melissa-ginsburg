---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import site from '../data/site.json';
import melissa from '../assets/melissa.jpg';
import { url, withoutBase } from '../lib/url';
import { textEm } from '../lib/fit';
import displayFont from '@fontsource/libre-caslon-display/files/libre-caslon-display-latin-400-normal.woff2?url';
import textFont from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url';
import italicFont from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-italic.woff2?url';

interface Props {
  /** Page title; omitted on the home page. */
  title?: string;
  description?: string;
  /** Image for link previews (a book cover, say). Defaults to Melissa's photo. */
  image?: ImageMetadata;
  /** The home page: the name is set large under the nav. */
  home?: boolean;
}

const { title, description = site.description, image = melissa, home = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const ogImage = await getImage({ src: image, width: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const pagePath = withoutBase(Astro.url.pathname);
const canonical = new URL(pagePath, Astro.site).href;

const nav = [
  { label: 'Books', href: '/books' },
  { label: 'Poems &c.', href: '/poems' },
  { label: 'News', href: '/news' },
  { label: 'About', href: '/about' },
];
const path = pagePath.replace(/\/$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
// One footer everywhere. "Contact" is the About page's contact section.
const footerLinks = [{ label: 'Contact', url: url('/about#contact') }, ...site.links];
// The header name's width at 1em, so a collage that runs up behind the header
// can keep clear of it.
const nameEm = textEm(site.name).toFixed(3);
---

<!doctype html>
<html lang="en" style={`--name-em: ${nameEm}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={italicFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#F3EEE5" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    {
      import.meta.env.DEV && (
        <script is:inline>
          if (new URLSearchParams(location.search).has('grid'))
            document.documentElement.classList.add('show-grid');
        </script>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class:list={['frame', 'site-header', { home }]}>
      <div class="bar">
        {
          home ? (
            // Holds the nav at the height it has on every other page.
            <span class="display site-name spacer" aria-hidden="true">
              {site.name}
            </span>
          ) : (
            <a class="display site-name" href={url('/')}>
              {site.name}
            </a>
          )
        }
        <nav aria-label="Main">
          <ul class="label nav">
            {
              nav.map((item) => (
                <li>
                  <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      {
        home && (
          <>
            <h1 class="display name">{site.name}</h1>
            <p class="site-tagline">{site.tagline}</p>
          </>
        )
      }
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="frame site-footer">
      <div class="footer-rule">
        <p class="footer-line">{site.footerNote}</p>
        <p class="footer-links links">
          {
            footerLinks.map((link, i) => (
              <>
                {i > 0 && (
                  <span class="sep" aria-hidden="true">
                    &nbsp;·&nbsp;
                  </span>
                )}
                <a href={link.url}>{link.label}</a>
              </>
            ))
          }
        </p>
      </div>
      <slot name="footer" />
    </footer>

    {
      import.meta.env.DEV && (
        <div class="frame grid grid-overlay" aria-hidden="true">
          {Array.from({ length: 12 }, () => (
            <span />
          ))}
        </div>
      )
    }
  </body>
</html>

<style>
  /* The name and the nav share one baseline; on the home page an unseen copy of
     the name holds the nav at the same height. */
  .site-header {
    padding-top: 12px;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: last baseline;
    column-gap: var(--space-s);
  }
  .site-name {
    font-size: 36px;
    line-height: 1.15;
    text-decoration: none;
  }
  .spacer {
    visibility: hidden;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    column-gap: 22px;
    font-size: 12px;
    letter-spacing: 0.14em;
  }
  /* Padding, not size, gives each word a 44px tap height. */
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0;
    text-decoration: none;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .nav a[aria-current='page']:hover {
    text-decoration-thickness: 2px;
  }
  .name {
    margin: 8px 0 0 -0.04em;
    font-size: clamp(64px, 11.5vw, 172px);
    line-height: 0.88;
    letter-spacing: -0.02em;
  }
  .site-tagline {
    /* Clears the name's descenders. */
    margin-top: calc(0.2 * clamp(64px, 11.5vw, 172px));
    font-size: 22px;
    font-style: italic;
    line-height: 1.3;
  }
  .site-footer {
    margin-top: var(--space-l);
    padding-bottom: var(--space-m);
  }
  .footer-rule {
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
    font-size: 15px;
    line-height: 1.75;
  }
  .footer-line {
    font-style: italic;
  }

  @media (max-width: 760px) {
    .bar {
      flex-direction: column;
      align-items: flex-start;
    }
    .spacer {
      display: none;
    }
    .site-name {
      font-size: 30px;
      padding-block: 5px;
    }
    /* The nav's tap height reaches below its words; the page is spaced from the
       words. */
    .site-header:not(.home) .nav {
      margin-bottom: -14px;
    }
    .nav {
      justify-content: flex-start;
      column-gap: 18px;
    }
    .name {
      font-size: 72px;
      margin-top: 4px;
    }
    .site-tagline {
      margin-top: 16px;
      font-size: 19px;
    }
    .footer-rule {
      font-size: 14px;
    }
  }
</style>

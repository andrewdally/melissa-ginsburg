---
// The top of every book page and the home page's hero: up to three flat
// blocks of the book's colours, the cover laid flat on them, and the title.
// Everything is placed by the book's `collage` preset, flipped left to right by
// `mirror`; no page sets its own CSS.
//
// Two rules hold in every preset, at every width:
// - A block sits behind title letters only where ink reads on its colour
//   (the "left" preset, checked at build time in content.config.ts). Elsewhere
//   the title is on paper, clear of every block.
// - An accent block (b2, b3) never touches the cover. The main block (b1) may
//   carry the cover, and is grown to hold a tall cover with 40px to spare.
import { Image } from 'astro:assets';
import Excerpt from './Excerpt.astro';
import OrderLinks from './OrderLinks.astro';
import { heroLabel, when, type Book } from '../lib/books';
import { coverMatches } from '../lib/cover';
import { fitStyle, longestWordEm, textEm } from '../lib/fit';
import { url } from '../lib/url';

interface Props {
  book: Book;
  /** "page": the book's own page, with its title as the h1. "home": the home hero. */
  variant?: 'page' | 'home';
}

const { book, variant = 'page' } = Astro.props;
const { title, kind, publisher, cover, coverAlt, color, color2, color3, textOn, excerpt, excerptStagger, shape } =
  book.data;
// A circle (only where the cover has one) tucks partly behind the main block.
const circle = shape === 'circle' && !!color2;
// The home hero always uses its own layout, whatever the book's own preset.
const preset = variant === 'home' ? 'home' : book.data.collage;
const mirror = variant === 'page' && book.data.mirror;
const href = url(`/books/${book.id}`);
const alt = coverAlt ? `Cover of ${title}: ${coverAlt}` : `Cover of ${title}`;

// "left" sets the title at up to 58% of the width; a title that needs two lines
// there starts higher, so the order link stays in the first screen.
const share = 0.58;
const size = Math.min(236, (1360 * share) / longestWordEm(title));
const lines = Math.max(1, Math.ceil((textEm(title) * size) / (1360 * share)));

const style = [
  `--c1: ${color}`,
  color2 && `--c2: ${color2}`,
  color3 && `--c3: ${color3}`,
  `--ratio: ${(cover.width / cover.height).toFixed(4)}`,
  `--lines: ${lines}`,
]
  .filter(Boolean)
  .join('; ');
const hairline = await coverMatches(cover, color);
const lead = variant === 'home' && excerpt ? excerpt.trim().split('\n').filter((l) => l.trim()).slice(0, 2).join('\n') : '';
// The title may cross onto the colour only where ink reads on it.
const crosses = variant === 'page' && textOn === 'ink';
// "door" stacks the title: the last word on a line of its own.
const words = title.split(/\s+/);
const stacked = preset === 'door' && words.length > 1;
const firstLine = words.slice(0, -1).join(' ');
const lastWord = words[words.length - 1];
const stackEm = stacked ? Math.max(textEm(firstLine), textEm(lastWord)) : textEm(title);
---

<div class:list={['collage', `collage--${preset}`, `collage--${variant}`, { crosses, mirror, circle }]} style={style}>
  <div class="stage">
    {circle && <div class="blk b2 round" aria-hidden="true" />}
    <div class="blk b1" aria-hidden="true"></div>
    {color2 && !circle && <div class="blk b2" aria-hidden="true" />}
    {color3 && <div class="blk b3" aria-hidden="true" />}
    <div class:list={['cover', { hairline }]}>
      {
        variant === 'home' ? (
          <a href={href}>
            <Image src={cover} alt={alt} widths={[360, 720]} sizes="(max-width: 760px) 52vw, 330px" loading="eager" />
          </a>
        ) : (
          <Image src={cover} alt={alt} widths={[360, 720]} sizes="(max-width: 760px) 52vw, 360px" loading="eager" />
        )
      }
    </div>
  </div>

  <div class="words">
    {
      variant === 'page' ? (
        <>
          <h1 class="display title" style={`${fitStyle(title)}; --stack-em: ${stackEm.toFixed(3)}`}>
            {stacked ? (
              <>
                {firstLine}
                <br />
                {lastWord}
              </>
            ) : (
              title
            )}
          </h1>
          <div class="meta">
            <p class="kind">{kind}</p>
            <p>
              {publisher}
              <br />
              {when(book)}
            </p>
            <OrderLinks book={book} max={3} class="meta-order" />
          </div>
        </>
      ) : (
        <>
          <div class="foot">
            <p class="label">{heroLabel(book)}</p>
            <h2 class="display title" style={fitStyle(title)}>
              <a href={href}>{title}</a>
            </h2>
            {lead && <Excerpt text={lead} stagger={excerptStagger} variant="hero" />}
            <OrderLinks book={book} max={1} class="hero-order" />
          </div>
        </>
      )
    }
  </div>
</div>

<style>
  /*
   * Desktop: blocks and cover are placed absolutely on a stage; the words are in
   * normal flow on top, so a long title makes the collage taller rather than
   * running into what follows. Vertical sizes are in --u (1px at full width).
   * --bleed reaches from the content edge to the edge of the window.
   */
  .collage {
    --col: calc((var(--content) + var(--gutter)) / 12);
    --bleed: calc(var(--margin) + (100vw - min(100vw, var(--max))) / 2);
    /* The cover: never cropped, tilted or shadowed. A tall cover gets narrower
       rather than taller than the space allows. */
    --cover-w: min(calc(var(--content) * var(--cw)), var(--cw-max), calc(var(--ch-max) * var(--u) * var(--ratio)));
    --cover-h: calc(var(--cover-w) / var(--ratio));
    --cover-top: calc(var(--ct) * var(--u));
    /* The main block holds a cover lying on it with 40px to spare. */
    --hold: calc(var(--cover-top) + var(--cover-h) + 40px);
    --cap: 1.5;

    position: relative;
    margin-top: var(--space-m);
    /* The collage ends at the lowest edge of its lowest block (--low), so the
       gap below it is measured from there. */
    min-height: var(--low, max(calc(var(--h) * var(--u)), var(--hold)));
  }
  .stage {
    position: absolute;
    inset: 0;
  }
  .mirror .stage {
    transform: scaleX(-1);
  }
  .mirror .cover :global(img) {
    transform: scaleX(-1);
  }
  .blk {
    position: absolute;
  }
  .b1 {
    background: var(--c1);
  }
  .b2 {
    background: var(--c2);
  }
  .b3 {
    background: var(--c3);
  }
  /* A circle: as wide as it is tall, whatever the preset's box. */
  .collage .blk.round {
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .cover {
    position: absolute;
    top: var(--cover-top);
    width: var(--cover-w);
  }
  /* A cover the colour of its block gets a hairline, so it doesn't dissolve. */
  .cover.hairline :global(img) {
    outline: 1px solid rgb(34 30 25 / 0.35);
  }
  .cover a {
    display: block;
    padding: 0;
  }
  .cover :global(img) {
    width: 100%;
    height: auto;
  }
  .words {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--words-top) * var(--u));
  }
  .title {
    /* No wider than its share of the page, and no more than two lines. */
    font-size: min(
      clamp(96px, 15.5vw, 236px),
      calc(var(--content) * var(--share) / var(--word-em)),
      calc(var(--content) * var(--share) * var(--cap) / var(--title-em))
    );
    line-height: 0.9;
    letter-spacing: -0.015em;
    /* Display titles sit tight; this clears their descenders. */
    margin-bottom: 0.2em;
    max-width: calc(var(--content) * var(--share));
  }
  .title a {
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }
  .meta {
    font-size: 19px;
    line-height: 1.5;
  }
  .meta > * + * {
    margin-top: var(--space-s);
  }
  .meta :global(.meta-order) {
    margin-top: calc(var(--space-s) - 10px);
  }
  .kind {
    font-size: 26px;
    font-style: italic;
    line-height: 1.2;
  }

  /* ---------- left: Runoff. A wide block from the left, the title crossing its
     right edge and the sliver behind it. The reference composition. ---------- */
  .collage--left {
    --h: 730;
    --ct: 84;
    /* A two-line title starts higher. */
    --words-top: calc(270 - (var(--lines) - 1) * 210);
    --share: 0.58;
    --cap: 99;
    --cw: 0.24;
    --cw-max: 340px;
    --ch-max: 620;
  }
  .collage--left .b1 {
    left: 0;
    top: 0;
    width: 56%;
    height: max(calc(640 * var(--u)), var(--hold));
  }
  .collage--left .b2 {
    left: 47%;
    top: calc(540 * var(--u));
    width: 21%;
    height: calc(190 * var(--u));
  }
  .collage--left .b3 {
    left: 56%;
    top: calc(110 * var(--u));
    width: 1.6%;
    height: calc(330 * var(--u));
  }
  .collage--left .cover {
    left: 9%;
  }
  /* The circle lies behind the block's lower right corner. */
  .collage--left.circle {
    --h: 760;
  }
  .collage--left .round {
    left: 46%;
    top: calc(540 * var(--u));
    width: 16%;
  }
  .collage--left .title {
    margin-left: 38%;
  }
  .collage--left .meta {
    margin-left: 72%;
    width: 24%;
  }
  /* Mirrored, the title ends on the block, crossing its left edge. */
  @media (min-width: 761px) {
    .collage--left.mirror .title {
      margin-left: 4%;
      width: 58%;
      text-align: right;
    }
    .collage--left.mirror .meta {
      margin-left: 4%;
    }
  }

  /* ---------- tower: a tall, narrow block bleeding off the right edge of the
     page, the cover half off it, a small piece over its upper left edge.
     The title on open paper. ---------- */
  .collage--tower {
    --h: 840;
    --low: max(
      calc(840 * var(--u)),
      var(--hold),
      calc(var(--cover-top) + var(--cover-h) + 32px + max(72px, 110 * var(--u))),
      calc(730 * var(--u) + max(72px, 110 * var(--u)))
    );
    --ct: 170;
    --words-top: 150;
    --share: 0.5;
    --cw: 0.26;
    --cw-max: 360px;
    --ch-max: 600;
  }
  .collage--tower .b1 {
    left: 76%;
    right: calc(-1 * var(--bleed));
    top: 0;
    height: max(calc(820 * var(--u)), var(--hold));
  }
  .collage--tower .b2 {
    left: 52%;
    top: max(calc(730 * var(--u)), calc(var(--cover-top) + var(--cover-h) + 32px));
    width: 30%;
    height: max(72px, calc(110 * var(--u)));
  }
  .collage--tower .b3 {
    left: 70%;
    top: 0;
    width: max(72px, 9%);
    height: max(72px, calc(110 * var(--u)));
  }
  .collage--tower .cover {
    left: 60%;
  }
  .collage--tower .meta {
    margin-left: var(--col);
    width: 28%;
  }
  @media (min-width: 761px) {
    .collage--tower.mirror .title {
      margin-left: 48%;
    }
    .collage--tower.mirror .meta {
      margin-left: calc(48% + var(--col));
    }
  }

  /* ---------- band: a broad band bleeding off the left edge, the cover half
     off its right end, a piece over its top edge. Title and details below. ---------- */
  /* Its highest edge is the cover's, 40 units down: the collage starts that
     much higher, so the gap above it is a full step. */
  .collage--band {
    --h: 450;
    --low: max(calc(450 * var(--u)), calc(var(--cover-top) + var(--cover-h)));
    margin-top: calc(var(--space-m) - 40 * var(--u));
    --ct: 40;
    --words-top: 520;
    --share: 0.5;
    --cw: 0.24;
    --cw-max: 340px;
    --ch-max: 520;
  }
  .collage--band .b1 {
    left: calc(-1 * var(--bleed));
    width: calc(var(--bleed) + 70%);
    top: calc(150 * var(--u));
    /* Broad, never a strip, however far it bleeds. */
    height: max(calc(300 * var(--u)), calc((var(--bleed) + var(--content) * 0.7) * 0.27));
  }
  .collage--band .b2 {
    left: 24%;
    top: calc(60 * var(--u));
    width: 12%;
    height: calc(150 * var(--u));
  }
  .collage--band .b3 {
    left: 88%;
    top: calc(300 * var(--u));
    width: 9%;
    height: calc(150 * var(--u));
  }
  .collage--band .cover {
    left: 60%;
  }
  .collage--band .words {
    display: grid;
    grid-template-columns: 50% 34%;
    column-gap: 10%;
    align-items: start;
    padding-left: var(--col);
  }
  .collage--band .meta {
    /* Below the cover. */
    margin-top: max(0px, calc(var(--cover-top) + var(--cover-h) + 32px - var(--words-top) * var(--u)));
  }
  @media (min-width: 761px) {
    .collage--band.mirror .words {
      grid-template-columns: 34% 50%;
    }
    .collage--band.mirror .title {
      order: 2;
    }
  }

  /* ---------- right: the block on the right, a narrow strip crossing its left
     edge; the words on paper at the left. ---------- */
  .collage--right {
    --h: 660;
    --low: max(calc(660 * var(--u)), calc(var(--hold) - 8px + 80 * var(--u)));
    --ct: 110;
    --words-top: 96;
    --share: 0.34;
    --cw: 0.23;
    --cw-max: 330px;
    --ch-max: 520;
  }
  .collage--right .b1 {
    left: 48%;
    right: calc(-1 * var(--bleed));
    top: calc(40 * var(--u));
    height: max(calc(560 * var(--u)), calc(var(--hold) - 40 * var(--u)));
  }
  .collage--right .b2 {
    left: 42%;
    top: 0;
    width: 9%;
    height: calc(420 * var(--u));
  }
  .collage--right .b3 {
    left: 66%;
    top: max(calc(580 * var(--u)), calc(var(--hold) - 8px));
    width: 22%;
    height: calc(80 * var(--u));
  }
  .collage--right .cover {
    left: 60%;
  }
  .collage--right .words {
    width: 36%;
  }
  @media (min-width: 761px) {
    .collage--right.mirror .words {
      margin-left: 64%;
    }
  }

  /* ---------- framed: the block inset like a frame, a strip bleeding off the
     left edge behind it, the title on paper to its right. ---------- */
  .collage--framed {
    --h: 750;
    --low: max(calc(750 * var(--u)), calc(var(--hold) - 60px + 150 * var(--u)));
    --ct: 96;
    --words-top: 120;
    --share: 0.36;
    --cw: 0.26;
    --cw-max: 360px;
    --ch-max: 620;
  }
  .collage--framed .b1 {
    left: 14%;
    top: 0;
    width: 44%;
    height: max(calc(700 * var(--u)), var(--hold));
  }
  .collage--framed .b2 {
    left: calc(-1 * var(--bleed));
    top: calc(330 * var(--u));
    width: calc(var(--bleed) + 20%);
    height: calc(420 * var(--u));
  }
  .collage--framed .b3 {
    left: 54%;
    top: max(calc(600 * var(--u)), calc(var(--hold) - 60px));
    width: 14%;
    height: calc(150 * var(--u));
  }
  .collage--framed .cover {
    left: 24%;
  }
  /* A circle peeks from behind the block's left edge. */
  .collage--framed .round {
    left: 3%;
    top: calc(300 * var(--u));
    width: 18%;
  }
  .collage--framed .title {
    margin-left: 61%;
  }
  .collage--framed .meta {
    margin-left: 68%;
    width: 28%;
  }
  @media (min-width: 761px) {
    .collage--framed.mirror .title {
      margin-left: 0;
    }
    .collage--framed.mirror .meta {
      margin-left: var(--col);
    }
  }

  /* ---------- door: a tall, narrow block down from the top of the page like
     a doorway, the cover set low on it and half off its right edge, a circle
     tucked behind its left edge level with the light in the cover (60% down),
     a doorstep at its foot. The title stacked on paper to the right. Where
     the block would run up behind the header's name, it starts lower. ---------- */
  .collage--door {
    --share: 0.4;
    --cw: 0.2;
    --cw-max: 300px;
    --ch-max: 520;
    --dl: max(calc(var(--content) * 0.24), calc(36px * var(--name-em) + 48px));
    --dw: calc(var(--content) * 0.24);
    --dtop: -400px;
    --door-b: calc(600 * var(--u));
    --cover-top: max(calc(40 * var(--u)), calc(var(--door-b) - 48px - var(--cover-h)));
    --title-x: calc(var(--dl) + var(--dw) + var(--cover-w) / 2 + 48px);
    --avail: calc(var(--content) - var(--title-x));
    --words-top: 0;
    --low: max(calc(var(--door-b) - 30 * var(--u) + max(70px, 100 * var(--u))), var(--hold));
  }
  @media (min-width: 761px) and (max-width: 1179px) {
    .collage--door {
      --dl: calc(var(--content) * 0.12);
      --dw: calc(var(--content) * 0.26);
      --dtop: 0px;
    }
  }
  .collage--door .b1 {
    left: var(--dl);
    width: var(--dw);
    top: var(--dtop);
    height: calc(var(--door-b) - var(--dtop));
  }
  /* The light: a circle tucked behind the block's left edge, its middle level
     with the light on the cover. Never past the outer margin. */
  .collage--door .b2 {
    --d: calc(var(--content) * 0.15);
    left: max(0px, calc(var(--dl) - var(--d) * 0.7));
    top: calc(var(--cover-top) + var(--cover-h) * 0.6 - var(--d) / 2);
    width: var(--d);
    height: var(--d);
  }
  /* The doorstep: a near-square at the foot of the block. */
  .collage--door .b3 {
    left: calc(var(--dl) + var(--dw) * 0.12);
    top: calc(var(--door-b) - 30 * var(--u));
    width: max(68px, calc(96 * var(--u)));
    height: max(70px, calc(100 * var(--u)));
  }
  .collage--door .cover {
    left: calc(var(--dl) + var(--dw) - var(--cover-w) / 2);
  }
  /* Its letters' tops, not its tight line box, sit a full step below the header. */
  .collage--door .title {
    padding-top: 0.165em;
    margin-left: var(--title-x);
    max-width: var(--avail);
    font-size: min(clamp(96px, 15.5vw, 236px), calc(var(--avail) / var(--stack-em)));
  }
  .collage--door .meta {
    margin-left: var(--title-x);
    width: min(var(--avail), 340px);
  }

  /* ---------- home: the featured book. The block runs down to the last line
     of the words; a small square is tucked into its lower left corner and
     hangs below it, a scrap crosses its top. The collage's box takes in the
     square, so the gap below is measured from its edge. ---------- */
  .collage--home {
    --h: 648;
    --hang: calc(48 * var(--u));
    --low: max(calc(648 * var(--u)), calc(var(--hold) + var(--hang)));
    --ct: 70;
    --words-top: 0;
    --share: 0.34;
    --cw: 0.23;
    --cw-max: 330px;
    --ch-max: 470;
    display: flex;
    padding-bottom: var(--hang);
  }
  .collage--home .b1 {
    left: 48%;
    right: calc(-1 * var(--bleed));
    top: 0;
    bottom: var(--hang);
  }
  /* A small square tucked into the block's lower left corner. */
  .collage--home .b2 {
    left: calc(48% - 50 * var(--u));
    width: calc(110 * var(--u));
    height: calc(110 * var(--u));
    bottom: 0;
  }
  /* 24px below the tagline, at every width. */
  .collage--home .b3 {
    left: 90%;
    top: -32px;
    width: max(64px, 7%);
    height: calc(120 * var(--u));
  }
  .collage--home .cover {
    right: 13%;
  }
  .collage--home .words {
    display: flex;
    flex-direction: column;
    width: 36%;
  }
  /* Label, title, lines and link in one group, on the block's bottom edge. */
  .foot {
    margin-top: auto;
  }
  .collage--home .label {
    margin-bottom: 20px;
  }
  .collage--home .title {
    font-size: min(clamp(64px, 8vw, 124px), calc(var(--content) * var(--share) / var(--word-em)));
    line-height: 0.92;
  }
  .collage--home :global(.hero-order) {
    margin-top: calc(var(--space-s) - 10px);
    /* The last line sits on the block's bottom edge. */
    margin-bottom: -0.3em;
  }

  /*
   * Phone: the collage is redrawn, not hidden. The stage is in flow and sized by
   * the cover; the title follows it, crossing the block's bottom edge where ink
   * reads on the colour, so title and order link show without scrolling far.
   */
  @media (max-width: 760px) {
    .collage {
      min-height: 0;
      margin-top: var(--space-s);
    }
    .collage--home {
      display: block;
    }
    .stage {
      position: relative;
      inset: auto;
      min-height: 300px;
      padding: 20px 0 28px;
    }
    .collage .blk {
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      width: auto;
      height: auto;
    }
    .collage .cover {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      width: min(48%, calc(340px * var(--ratio)));
    }
    .collage .words {
      display: block;
      padding: 0;
      width: auto;
      margin-left: 0;
    }
    .collage .title {
      margin-left: 0;
      margin-top: var(--space-s);
      width: auto;
      max-width: none;
      text-align: left;
      /* No wider than its longest word, and no more than about two lines. */
      font-size: min(
        92px,
        calc(var(--content) * 0.94 / var(--word-em)),
        calc(var(--content) * 1.5 / var(--title-em))
      );
    }
    .crosses .title {
      margin-top: -0.42em;
    }
    .collage .meta {
      margin: 0;
      width: auto;
      font-size: 17px;
    }
    .meta > * + * {
      margin-top: var(--space-s);
    }
    .meta > .kind + * {
      margin-top: 2px;
    }
    .kind {
      font-size: 21px;

---
import { render, type CollectionEntry } from 'astro:content';
import Row from './Row.astro';
import { formatDate, isoDate } from '../lib/books';
import { inline } from '../lib/inline';

interface Props {
  item: CollectionEntry<'news'>;
  /** Links already on the page (the hero's order links): not repeated here. */
  skip?: string[];
}

const { item, skip = [] } = Astro.props;
const { Content } = await render(item);
const { title, date, linkLabel } = item.data;
const link = item.data.link && !skip.includes(item.data.link) ? item.data.link : undefined;
---

<Row as="li">
  <time slot="note" datetime={isoDate(date)}>{formatDate(date)}</time>
  <h2 class="news-title" set:html={inline(title)} />
  <div class="prose">
    <Content />
  </div>
  {
    link && (
      <p class="news-link">
        <a href={link}>{linkLabel ?? 'More'}</a>
      </p>
    )
  }
</Row>

<style>
  /* A headline at reading size, in roman; book titles in it are italic. */
  .news-title {
    font-size: inherit;
    line-height: inherit;
    text-wrap: pretty;
  }
</style>

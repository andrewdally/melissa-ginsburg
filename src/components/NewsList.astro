---
import { render, type CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/books';

interface Props {
  items: CollectionEntry<'news'>[];
}

const { items } = Astro.props;
const rendered = await Promise.all(
  items.map(async (item) => ({ item, Content: (await render(item)).Content })),
);
---

<ol class="news">
  {
    rendered.map(({ item, Content }) => (
      <li>
        <p class="date sans">
          <time datetime={item.data.date.toISOString().slice(0, 10)}>{formatDate(item.data.date)}</time>
        </p>
        <h3 class="news-title">{item.data.title}</h3>
        <div class="prose">
          <Content />
        </div>
        {item.data.link && (
          <p class="sans link">
            <a href={item.data.link}>{item.data.linkLabel ?? 'More'} →</a>
          </p>
        )}
      </li>
    ))
  }
</ol>

<style>
  .news {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .date {
    margin: 0 0 4px;
    font-size: 14px;
    color: var(--muted);
  }
  .news-title {
    margin: 0 0 8px;
    font-size: 28px;
  }
  .link {
    margin: 8px 0 0;
  }
  .link a {
    display: inline-block;
    padding: 8px 0;
    font-weight: 600;
  }
</style>

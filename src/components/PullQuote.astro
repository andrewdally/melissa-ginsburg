---
import { inline } from '../lib/inline';

interface Props {
  quote: string;
  name: string;
  url?: string;
}

const { quote, name, url } = Astro.props;
---

<figure class="grid pull">
  <blockquote class="col-wide display" set:html={`“${inline(quote)}”`} />
  <figcaption class="col-wide label">
    {url ? <a href={url}>{name}</a> : name}
  </figcaption>
</figure>

<style>
  blockquote {
    font-size: clamp(40px, 5vw, 76px);
    line-height: 1.05;
    hanging-punctuation: first;
  }
  figcaption {
    margin-top: var(--space-s);
  }
  @media (max-width: 760px) {
    blockquote {
      font-size: 40px;
      line-height: 1.08;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import type { Book } from '../lib/books';

interface Props {
  books: Book[];
  /** Show publisher and year under each title. */
  details?: boolean;
}

const { books, details = false } = Astro.props;
const tilts = ['tilt-a', 'tilt-b', 'tilt-c', 'tilt-d'];
---

<ul class="shelf">
  {
    books.map((book, i) => (
      <li>
        <a href={`/books/${book.id}`}>
          <Image
            src={book.data.cover}
            alt=""
            widths={[180, 360]}
            sizes="180px"
            class:list={['cover', tilts[i % tilts.length]]}
          />
          <span class="book-title">{book.data.title}</span>
          {details && (
            <span class="book-details sans">
              {[book.data.publisher, book.data.year].filter(Boolean).join(', ')}
            </span>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .shelf {
    list-style: none;
    margin: 0;
    padding: 0 8px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 48px 48px;
  }
  @media (max-width: 480px) {
    .shelf {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 28px;
    }
  }
  .shelf a {
    display: block;
    text-decoration: none;
  }
  .shelf :global(.cover) {
    aspect-ratio: 2 / 3;
    object-fit: cover;
    margin-bottom: 16px;
  }
  .book-title {
    display: block;
    font-style: italic;
    font-size: 21px;
    line-height: 1.25;
  }
  .book-details {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    color: var(--muted);
  }
</style>

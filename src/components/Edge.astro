---
// Three pieces of paper in the featured book's own colours, clustered at one
// edge of a list page (News, Poems &c.). Placed inside the element they belong
// to (the first news item; the poems run), which must be positioned; they lie
// behind its text. Text may run over the main colour and the light accent,
// so ink must read on both at 4.5:1 (a colour that falls short is mixed with
// paper until it passes). The dark accent stays in the margin, clear of text.
import { INK, contrast, tint } from '../lib/color';
import { getFeaturedBook } from '../lib/books';

interface Props {
  layout: 'news' | 'poems';
  /** Shown only on a phone, or only wider. */
  only?: 'phone' | 'wide';
}

const MIN = 4.5;
const { layout, only } = Astro.props;
const { color, color2, color3 } = (await getFeaturedBook()).data;

/** The colour itself, or as little paper mixed in as lets ink read on it. */
function readable(c: string) {
  for (let a = 1; a > 0; a -= 0.02) {
    const t = tint(c, a);
    if (contrast(t, INK) >= MIN) return t;
  }
  return tint(c, 0);
}

// Of the accents, ink reads better on the light one.
const [light, dark] = [color2, color3]
  .filter((c): c is string => !!c)
  .sort((a, b) => contrast(b, INK) - contrast(a, INK));
const style = [`--e1: ${readable(color)}`, light && `--e2: ${readable(light)}`, dark && `--e3: ${dark}`]
  .filter(Boolean)
  .join('; ');
---

<div class:list={['edge', layout, only && `only-${only}`]} style={style} aria-hidden="true">
  {dark && <i class="p3" />}
  <i class="p1"></i>
  {light && <i class="p2" />}
</div>

<style>
  /* Behind the text of the element it sits in (the page itself is the paper). */
  .edge {
    --bleed: calc(var(--margin) + (100vw - min(100vw, var(--max))) / 2);
    /* One grid column: the dark piece fills the margin up to the text. */
    --col: calc((var(--content) - 11 * var(--gutter)) / 12);
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }
  i {
    position: absolute;
    display: block;
  }
  .p1 {
    background: var(--e1);
  }
  .p2 {
    background: var(--e2);
  }
  /* The dark piece fills the margin beside the text, from the window edge. */
  .p3 {
    background: var(--e3);
    width: calc(var(--bleed) + var(--col));
    height: 160px;
  }

  /*
   * A piece behind text is a sheet, not a highlighter: at least 240px tall
   * and wider than every line it crosses, so whole lines sit on it. Smaller
   * pieces stay in the margins, clear of text.
   */
  .edge {
    /* Left edge of grid column n (1-based) is (n - 1) * (col + gutter). */
    --step: calc(var(--col) + var(--gutter));
  }

  /* News: a sheet from the right edge under the whole first item, from 32px
     left of its text; the light piece in the empty column left of the text,
     over the sheet's lower left corner; the dark square on the sheet's top
     right corner, in the margin beyond the text. */
  .news {
    --top: -32px;
    /* Tall enough for the item, at least 240px, and never under 1:4. */
    --sheet: max(calc(100% + 64px), 240px, calc((var(--content) - var(--step) * 5 + 32px + var(--bleed)) / 3.8));
  }
  .news .p1 {
    left: calc(var(--step) * 5 - 32px);
    right: calc(-1 * var(--bleed));
    top: var(--top);
    height: var(--sheet);
  }
  .news .p2 {
    --w: max(90px, var(--step));
    left: calc(var(--step) * 5 - 8px - var(--w));
    width: var(--w);
    top: calc(var(--top) + var(--sheet) - 140px);
    height: 130px;
  }
  .news .p3 {
    right: calc(-1 * var(--bleed));
    top: calc(var(--top) + 32px);
  }

  /* Poems (placed in the run itself, which sets the line height): a sheet
     under the run's last whole lines, 32px past both ends of every line, its
     top and bottom on line boundaries so no line is cut; the light piece in
     the right margin, stepping up from the sheet's top right corner; the dark
     square in the left margin beside the sheet's lower left corner. */
  .poems {
    /* The run's width plus 32px each side. */
    --sw: calc(var(--step) * 10 - var(--gutter) + 64px);
    /* At least 240px, and at least a quarter of its width, in whole lines. */
    --sh: max(round(up, 240px, 1lh), round(up, calc(var(--sw) * 0.25), 1lh));
  }
  .poems .p1 {
    left: -32px;
    right: -32px;
    bottom: 0;
    height: var(--sh);
  }
  .poems .p2 {
    left: calc(100% + 8px);
    right: calc(-1 * (var(--gutter) + var(--col) + var(--bleed)));
    top: calc(100% - var(--sh) - 140px);
    height: 180px;
  }
  .poems .p3 {
    left: calc(-1 * (var(--gutter) + var(--col) + var(--bleed)));
    top: calc(100% - 200px);
  }

  @media (max-width: 760px) {
    .only-wide {
      display: none;
    }
  }
  @media (min-width: 761px) {
    .only-phone {
      display: none;
    }
  }

  /* The margin is too narrow for a square of any size below this. */
  @media (max-width: 1039px) {
    .p3 {
      display: none;
    }
  }
  @media (min-width: 761px) and (max-width: 1039px) {
    .poems .p2 {
      display: none;
    }
  }

  /* Phone: two pieces at the top edge, above the content (the element they
     belong to leaves 96px for them). */
  @media (max-width: 760px) {
    .edge {
      inset: auto 0;
      top: -96px;
      height: 72px;
    }
    .news .p1 {
      left: auto;
      right: calc(-1 * var(--bleed));
      width: calc(var(--bleed) + 180px);
      top: 0;
      height: 56px;
    }
    .news .p2 {
      left: auto;
      right: 150px;
      width: 90px;
      top: 16px;
      bottom: auto;
      height: 56px;
    }
    .poems .p1 {
      left: calc(-1 * var(--bleed));
      width: calc(var(--bleed) + 180px);
      top: 16px;
      height: 56px;
    }
    .poems .p2 {
      left: 150px;
      right: auto;
      width: 90px;
      top: 0;
      height: 64px;
    }
  }
</style>

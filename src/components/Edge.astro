---
// Three pieces of paper in the featured book's own colours, clustered at one
// edge of a list page (News, Poems &c.). Placed inside the element they belong
// to (the first news item; the poems run), which must be positioned; they lie
// behind its text. Text may run over the main colour and the light accent,
// so ink must read on both at 4.5:1 (a colour that falls short is mixed with
// paper until it passes). The dark accent stays in the margin, clear of text.
import { INK, contrast, tint } from '../lib/color';
import { getFeaturedBook } from '../lib/books';

interface Props {
  layout: 'news' | 'poems';
}

const MIN = 4.5;
const { layout } = Astro.props;
const { color, color2, color3 } = (await getFeaturedBook()).data;

/** The colour itself, or as little paper mixed in as lets ink read on it. */
function readable(c: string) {
  for (let a = 1; a > 0; a -= 0.02) {
    const t = tint(c, a);
    if (contrast(t, INK) >= MIN) return t;
  }
  return tint(c, 0);
}

// Of the accents, ink reads better on the light one.
const [light, dark] = [color2, color3]
  .filter((c): c is string => !!c)
  .sort((a, b) => contrast(b, INK) - contrast(a, INK));
const style = [`--e1: ${readable(color)}`, light && `--e2: ${readable(light)}`, dark && `--e3: ${dark}`]
  .filter(Boolean)
  .join('; ');
---

<div class:list={['edge', layout]} style={style} aria-hidden="true">
  {dark && <i class="p3" />}
  <i class="p1"></i>
  {light && <i class="p2" />}
</div>

<style>
  /* Behind the text of the element it sits in (the page itself is the paper). */
  .edge {
    --bleed: calc(var(--margin) + (100vw - min(100vw, var(--max))) / 2);
    /* One grid column: the dark piece fills the margin up to the text. */
    --col: calc((var(--content) - 11 * var(--gutter)) / 12);
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }
  i {
    position: absolute;
    display: block;
  }
  .p1 {
    background: var(--e1);
  }
  .p2 {
    background: var(--e2);
  }
  .p3 {
    background: var(--e3);
    /* A square filling the margin beside the text. */
    width: min(calc(var(--bleed) + var(--col)), 160px);
    aspect-ratio: 1;
  }

  /* News: from the right edge, beside the first item and as tall as it; the
     light piece over the main block's lower left corner, under the item's last
     lines; the dark square on the main block's top edge, out in the margin. */
  .news .p1 {
    right: calc(-1 * var(--bleed));
    width: calc(30% + var(--bleed));
    top: 0;
    height: max(100%, 200px);
  }
  .news .p2 {
    left: 54%;
    width: 24%;
    top: 58%;
    bottom: -32px;
  }
  .news .p3 {
    right: calc(-1 * var(--bleed));
    top: -32px;
  }

  /* Poems: from the left edge, level with the middle of the run; the light
     piece steps up from the main block into the run; the dark square hangs
     below it in the margin. */
  .poems {
    /* Broad, never a strip, however far it bleeds. */
    --p1h: max(26%, 150px, calc((var(--bleed) + var(--content) * 0.34) * 0.27));
    --p3s: min(calc(var(--bleed) + var(--col)), 160px);
  }
  .poems .p1 {
    left: calc(-1 * var(--bleed));
    width: calc(var(--bleed) + 34%);
    top: 42%;
    height: var(--p1h);
  }
  .poems .p2 {
    left: 26%;
    width: 16%;
    top: calc(42% - 90px);
    height: 130px;
  }
  /* Within the run's section, so the gap below it holds. */
  .poems .p3 {
    left: calc(-1 * var(--bleed));
    top: min(calc(42% + var(--p1h) - 30px), calc(100% - var(--p3s)));
  }

  /* The margin is too narrow for a square of any size below this. */
  @media (max-width: 1039px) {
    .p3 {
      display: none;
    }
  }

  /* Phone: two pieces at the top edge, above the content (the element they
     belong to leaves 96px for them). */
  @media (max-width: 760px) {
    .edge {
      inset: auto 0;
      top: -96px;
      height: 72px;
    }
    .news .p1 {
      right: calc(-1 * var(--bleed));
      width: calc(var(--bleed) + 180px);
      top: 0;
      height: 56px;
    }
    .news .p2 {
      left: auto;
      right: 150px;
      width: 90px;
      top: 16px;
      bottom: auto;
      height: 56px;
    }
    .poems .p1 {
      left: calc(-1 * var(--bleed));
      width: calc(var(--bleed) + 180px);
      top: 16px;
      height: 56px;
    }
    .poems .p2 {
      left: 150px;
      width: 90px;
      top: 0;
      height: 72px;
    }
  }
</style>

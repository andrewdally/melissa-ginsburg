---
import { Image } from 'astro:assets';
import { isUpcoming, publicationLine, type Book } from '../lib/books';

interface Props {
  book: Book;
  /** On the home page, link through to the book's own page. */
  moreLink?: boolean;
}

const { book, moreLink = false } = Astro.props;
const { title, kind, tagline, cover, coverAlt, buy } = book.data;
const buyVerb = isUpcoming(book) ? 'Preorder from' : 'Order from';
---

<section class="wrap hero">
  <div class="hero-cover">
    <Image
      src={cover}
      alt={coverAlt ? `Cover of ${title}: ${coverAlt}` : `Cover of ${title}`}
      widths={[360, 720]}
      sizes="(max-width: 640px) 80vw, 360px"
      loading="eager"
      class="cover"
    />
  </div>
  <div class="hero-text">
    <h1 class="title">{title}</h1>
    <p class="kind">{kind}</p>
    {tagline && <p class="tagline">{tagline}</p>}
    <p class="published">{publicationLine(book)}</p>
    {
      buy.length > 0 && (
        <p class="sans buy slashes">
          {buyVerb}{' '}
          {buy.map((link, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">/</span>}
              <a href={link.url}>{link.label}</a>
            </>
          ))}
        </p>
      )
    }
    {
      moreLink && (
        <p class="sans more">
          <a href={`/books/${book.id}`}>More about {title} →</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 48px 80px;
    padding-top: 56px;
  }
  .hero-cover {
    flex: 0 1 360px;
    min-width: 220px;
    padding: 0 8px;
  }
  .hero-cover :global(.cover) {
    rotate: -2.5deg;
    box-shadow: 0 16px 36px rgb(27 26 24 / 0.28);
  }
  .hero-text {
    flex: 1 1 420px;
    min-width: 0;
    padding-bottom: 8px;
  }
  .title {
    margin: 0;
    font-style: italic;
    font-size: clamp(72px, 12vw, 156px);
    line-height: 0.85;
    letter-spacing: -0.015em;
  }
  .kind {
    margin: 6px 0 32px;
    font-style: italic;
    font-size: 30px;
    line-height: 1.2;
  }
  .tagline {
    margin: 0 0 16px;
    max-width: 24em;
    font-size: 26px;
    line-height: 1.4;
  }
  .published {
    margin: 0 0 12px;
    font-style: italic;
  }
  .buy,
  .more {
    margin: 0;
    line-height: 1.6;
  }
  .buy a,
  .more a {
    display: inline-block;
    padding: 10px 0;
    font-weight: 600;
  }
</style>

---
// A book on the collage wall: a block of its main colour with the title set on
// it, and its accent colour peeking out from behind. The whole tile is the link.
import { kindAndYear, type Book } from '../lib/books';
import { textColor } from '../lib/color';
import { fitStyle } from '../lib/fit';
import { url } from '../lib/url';

interface Props {
  book: Book;
  index: number;
}

const { book, index } = Astro.props;
const { title, color, color2, textOn, tile } = book.data;
const style = `--c1: ${color}; --on: ${textColor(textOn)};${color2 ? ` --c2: ${color2};` : ''}`;
---

<a
  class:list={['tile', tile, `v${index % 4}`]}
  href={url(`/books/${book.id}`)}
  style={`${style} --i: ${index};`}
>
  {color2 && <span class="back" aria-hidden="true" />}
  <span class="face">
    <span class="display t" style={fitStyle(title)}>{title}</span>
    <span class="k">{kindAndYear(book)}</span>
  </span>
</a>

<style>
  .tile {
    position: relative;
    display: block;
    flex: none;
    width: var(--w);
    height: var(--h);
    max-width: 100%;
    padding: 0;
    text-decoration: none;
    color: var(--on);
    /* Across a row, each tile lies over the one before; titles sit left. */
    z-index: calc(1 + var(--i));
  }
  .face {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    padding: 22px 24px;
    background: var(--c1);
  }
  .back {
    position: absolute;
    z-index: 0;
    background: var(--c2);
  }
  .t {
    font-size: min(var(--t), calc((var(--w) - 48px) / var(--word-em)));
    line-height: 0.95;
  }
  .tile:hover .t {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }
  .k {
    margin-top: 10px;
    font-size: 15px;
    font-style: italic;
    line-height: 1.4;
  }

  .large { --w: 400px; --h: 330px; --t: 62px; }
  .tall { --w: 310px; --h: 400px; --t: 54px; }
  .wide { --w: 380px; --h: 280px; --t: 56px; }
  .small { --w: 290px; --h: 240px; --t: 54px; }

  /* The accent colour lies behind a left-hand corner, offset diagonally: never
     a strip along an edge, which reads as a folder tab. (On the right, the next
     tile would cover all but such a strip.) It reaches no more than 18px to the
     left, inside the 20px by which tiles overlap, so it can't touch the title
     of the tile before. */
  .v0 .back { left: -18px; top: -22px; width: 40%; height: 46%; }
  .v1 .back { left: -18px; bottom: -24px; width: 46%; height: 36%; }
  .v2 .back { left: -18px; top: -24px; width: 34%; height: 58%; }
  .v3 .back { left: -18px; bottom: -22px; width: 58%; height: 30%; }
  /* A scrap below a tile counts toward its height in the row, so the wall ends
     at its lowest edge and the gap below it is measured from there. */
  .v1:has(.back) { margin-bottom: 24px; }
  .v3:has(.back) { margin-bottom: 22px; }

  /* Below 900px the wall becomes a pile; see Wall.astro. */
  @media (max-width: 900px) {
    .face {
      padding: 16px 18px;
    }
    .t {
      font-size: min(var(--t), calc((var(--content) * var(--pw) - 36px) / var(--word-em)));
    }
    .k {
      margin-top: 8px;
      font-size: 14px;
    }
    .large { --pw: 0.88; --h: 230px; --t: 46px; }
    .tall { --pw: 0.72; --h: 240px; --t: 42px; }
    .wide { --pw: 0.82; --h: 190px; --t: 42px; }
    .small { --pw: 0.68; --h: 170px; --t: 40px; }
    /* Down the pile, each tile lies over the top of the next; titles sit low. */
    .tile {
      width: calc(var(--pw) * 100%);
      z-index: calc(100 - var(--i));
    }
    .v1:has(.back),
    .v3:has(.back) {
      margin-bottom: 0;
    }
    /* Down the pile, scraps peek out at the sides, clear of the next title. */
    .tile .back { left: auto; right: auto; bottom: auto; }
    .v0 .back { right: -14px; top: -12px; width: 34%; height: 40%; }
    .v1 .back { left: -14px; top: -12px; width: 36%; height: 44%; }
    .v2 .back { right: -14px; top: -12px; width: 40%; height: 38%; }
    .v3 .back { left: -14px; top: -12px; width: 34%; height: 42%; }
  }
</style>

---
// Lines from the book, set large in the wide column: the one place type may run
// wider than the reading column. Each line keeps its break; a long line wraps
// with a hanging indent, as poems are set.
interface Props {
  text: string;
  /** Indent every other line. */
  stagger?: boolean;
}

const { text, stagger = false } = Astro.props;
const stanzas = text
  .trim()
  .split(/\n\s*\n/)
  .map((stanza) => stanza.split('\n').map((line) => line.trim()));
---

<div class="grid section">
  <div class:list={['col-wide', 'excerpt', { stagger }]}>
    {
      stanzas.map((lines) => (
        <p class="stanza">
          {lines.map((line) => (
            <span class="line">{line}</span>
          ))}
        </p>
      ))
    }
  </div>
</div>

<style>
  .excerpt {
    /* Poems keep their words whole. */
    hyphens: manual;
    font-size: clamp(30px, 3.4vw, 50px);
    line-height: 1.3;
  }
  .stanza + .stanza {
    margin-top: 1.3em;
  }
  .line {
    display: block;
    padding-left: 1.2em;
    text-indent: -1.2em;
  }
  .stagger .line:nth-child(even) {
    margin-left: 2.4em;
  }
  @media (max-width: 760px) {
    .excerpt {
      font-size: 23px;
      line-height: 1.4;
    }
    .stagger .line:nth-child(even) {
      margin-left: 1.2em;
    }
  }
</style>
